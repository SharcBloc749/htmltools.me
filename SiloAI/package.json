{
  "name": "siloai-site-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source website-aware assistant and Cloudflare Worker for SiloAI.",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run bundle",
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "tail": "wrangler tail siloai"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.3",
    "wrangler": "^4.0.0"
  }
}
