{
  "openapi": "3.1.0",
  "info": {
    "title": "htmltools.me AI API",
    "version": "1.0.0",
    "description": "OpenAI-compatible chat completions gateway running on Cloudflare Workers. Free shared pool on Cloudflare Workers AI, or the caller's own Groq key. Only the model ids listed by GET /v1/models are accepted.",
    "contact": { "url": "https://htmltools.me/AI-API/Docs/" }
  },
  "servers": [
    { "url": "https://htmltools-me-ai-api.bozhetarnikmatthew.workers.dev", "description": "Production gateway" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "security": [],
        "responses": {
          "200": { "description": "Service is up", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "service": { "type": "string" }, "version": { "type": "string" } } } } } }
        }
      }
    },
    "/public/status": {
      "get": {
        "summary": "Shared free-pool status and model catalogue",
        "security": [],
        "responses": {
          "200": { "description": "Pool counters (no prompts, no keys)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicStatus" } } } }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List allowlisted models",
        "description": "Authenticates the key but does not consume the daily request quota.",
        "responses": {
          "200": { "description": "OpenAI model list with an x_ht extension", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelList" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Create a chat completion",
        "description": "OpenAI-compatible request and response. Set stream=true for server-sent events.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Completion, or an SSE stream when stream=true",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ChatCompletion" } },
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "description": "Request body too large", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "description": "Provider failure", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "ht-<30 lowercase characters>" }
    },
    "schemas": {
      "Message": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant", "tool", "developer"] },
          "content": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "text" }, "text": { "type": "string" } } } }] },
          "name": { "type": "string" },
          "tool_call_id": { "type": "string" },
          "tool_calls": { "type": "array", "items": { "type": "object" } }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": ["model", "messages"],
        "properties": {
          "model": { "type": "string", "description": "An allowlisted id or \"auto\"" },
          "messages": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/components/schemas/Message" } },
          "stream": { "type": "boolean", "default": false },
          "max_tokens": { "type": "integer", "minimum": 1, "description": "Clamped to the model ceiling" },
          "max_completion_tokens": { "type": "integer", "minimum": 1 },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7 },
          "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
          "stop": { "oneOf": [{ "type": "string" }, { "type": "array", "maxItems": 4, "items": { "type": "string" } }] },
          "tools": { "type": "array", "maxItems": 16, "items": { "type": "object" } },
          "tool_choice": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
          "response_format": { "type": "object", "properties": { "type": { "type": "string", "enum": ["text", "json_object"] } } },
          "frequency_penalty": { "type": "number", "minimum": -2, "maximum": 2 },
          "presence_penalty": { "type": "number", "minimum": -2, "maximum": 2 },
          "seed": { "type": "integer" },
          "stream_options": { "type": "object", "properties": { "include_usage": { "type": "boolean" } } }
        }
      },
      "ChatCompletion": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "chat.completion" },
          "created": { "type": "integer" },
          "model": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": { "type": "integer" },
                "message": {
                  "type": "object",
                  "properties": {
                    "role": { "const": "assistant" },
                    "content": { "type": ["string", "null"] },
                    "tool_calls": { "type": "array", "items": { "type": "object" } }
                  }
                },
                "finish_reason": { "type": "string" }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": { "type": "integer" },
              "completion_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" }
            }
          }
        }
      },
      "ModelList": {
        "type": "object",
        "properties": {
          "object": { "const": "list" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "object": { "const": "model" },
                "created": { "type": "integer" },
                "owned_by": { "type": "string" },
                "x_ht": { "type": "object" }
              }
            }
          }
        }
      },
      "PublicStatus": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "pool": {
            "type": "object",
            "properties": {
              "budget": { "type": "number" },
              "spent": { "type": "number" },
              "remaining": { "type": "number" },
              "percentRemaining": { "type": "number" },
              "requestsToday": { "type": "number" },
              "requestCap": { "type": "number" },
              "resetsAt": { "type": "string", "format": "date-time" },
              "exhausted": { "type": "boolean" }
            }
          },
          "models": { "type": "array", "items": { "type": "object" } }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["message", "type", "code"],
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string" },
              "param": { "type": ["string", "null"] },
              "code": { "type": "string" }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid or revoked key",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BadRequest": {
        "description": "Invalid request, model not allowed, or unsupported feature",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RateLimited": {
        "description": "Rate limit or quota exhausted. Retry-After is in seconds.",
        "headers": { "retry-after": { "schema": { "type": "integer" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
